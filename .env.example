# ============================================================
# knowledge-system 环境变量示例
# 复制为 backend/.env（本地启动用）或项目根目录 .env（docker 用）
# 不要将此文件的真实凭据提交到 Git。
# ============================================================

# ---- 应用 / JWT ----
SECRET_KEY=your-secret-key-here
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---- 数据库（本地启动时改为本机 MySQL；docker 部署时这里可不填）----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=knowledge_system

# ---- CORS（前端站点地址，逗号分隔的 JSON 数组）----
CORS_ORIGINS=["http://localhost:5173"]

# ---- 服务器外部访问地址（用于生成图片链接），部署时改为实际地址 ----
BASE_URL=http://localhost:5173

# ---- 上传限制（字节，默认 10MB）----
MAX_FILE_SIZE=10485760

# ---- 智谱 AI（可选，文章 URL 导入时的 AI 提取） ----
ZHIPU_API_KEY=your-zhipu-api-key

# ============================================================
# 以下仅 Docker 一键部署使用（放在项目根目录 .env）
# ============================================================
# MYSQL_ROOT_PASSWORD=root
# DB_USER=knowledge_user
# DB_PASSWORD=Knowledge@123
# DB_NAME=knowledge_system
# FRONTEND_PORT=5173
# VITE_API_BASE_URL=/api/v1